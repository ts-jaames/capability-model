{
  "$id": "https://capability-model.local/schema/capability.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "domain",
    "promise",
    "client_experience",
    "sparq_how",
    "levels",
    "agent_skills"
  ],
  "properties": {
    "capability": { "$ref": "common.json#/$defs/nonEmptyString" },
    "domain": {
      "type": "string",
      "enum": [
        "Commercial",
        "Framing",
        "Building",
        "Proof",
        "Enablement",
        "Continuity"
      ]
    },
    "promise": { "$ref": "common.json#/$defs/nonEmptyString" },
    "client_experience": { "$ref": "common.json#/$defs/nonEmptyString" },
    "sparq_how": { "$ref": "common.json#/$defs/nonEmptyString" },
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L2", "L3"],
      "properties": {
        "L1": { "$ref": "common.json#/$defs/nonEmptyString" },
        "L2": { "$ref": "common.json#/$defs/nonEmptyString" },
        "L3": { "$ref": "common.json#/$defs/nonEmptyString" }
      }
    },
    "levels_mode": {
      "type": "string",
      "enum": ["standard-ladder", "specific"],
      "default": "standard-ladder"
    },
    "visibility": { "$ref": "common.json#/$defs/visibility" },
    "not_at_l1": { "$ref": "common.json#/$defs/nonEmptyString" },
    "l1_guardrails": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.json#/$defs/nonEmptyString" }
    },
    "l1_l2_boundary": { "$ref": "common.json#/$defs/nonEmptyString" },
    "scope_decomposition": {
      "description": "How many independent instances of this capability an engagement needs, as opposed to how senior the work is. Either defined (a unit, a leverage per level, an intake question) or explicitly not yet defined. A capability with no block is also not yet defined. scope_units itself is per-engagement and is never stored here.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit_definition",
            "scales_with_scope",
            "leverage_by_level",
            "confidence",
            "intake_prompt"
          ],
          "properties": {
            "unit_definition": { "$ref": "common.json#/$defs/nonEmptyString" },
            "scales_with_scope": { "type": "boolean" },
            "leverage_by_level": {
              "type": "object",
              "additionalProperties": false,
              "required": ["L1", "L2", "L3", "L4"],
              "properties": {
                "L1": { "type": "integer", "minimum": 1 },
                "L2": { "type": "integer", "minimum": 1 },
                "L3": { "type": "integer", "minimum": 1 },
                "L4": { "type": "integer", "minimum": 1 }
              }
            },
            "confidence": {
              "description": "[ASSUMED] is a number written down to make the model runnable, [UNTESTED] is an unchecked claim. [VALIDATED] is deliberately not allowed yet: nothing here has been recovered from real delivery.",
              "type": "string",
              "enum": ["[ASSUMED]", "[UNTESTED]"]
            },
            "intake_prompt": { "$ref": "common.json#/$defs/nonEmptyString" },
            "notes": { "$ref": "common.json#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "const": "not_yet_defined" },
            "open_question": { "$ref": "common.json#/$defs/nonEmptyString" }
          }
        }
      ]
    },
    "agent_skills": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "what", "status"],
        "properties": {
          "name": { "$ref": "common.json#/$defs/kebabId" },
          "what": { "$ref": "common.json#/$defs/nonEmptyString" },
          "status": { "type": "string", "enum": ["live", "building", "gap"] }
        }
      }
    }
  }
}
