{
  "$id": "https://capability-model.local/schema/deferrals.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deferrals",
  "description": "Concepts the published model talks about but deliberately does not model yet. Recording one is how a known hole stops being an accidental contradiction.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "owner", "last_updated", "deferred"],
  "properties": {
    "id": { "$ref": "common.json#/$defs/kebabId" },
    "name": { "$ref": "common.json#/$defs/nonEmptyString" },
    "description": { "$ref": "common.json#/$defs/nonEmptyString" },
    "status": { "$ref": "common.json#/$defs/status" },
    "owner": { "$ref": "common.json#/$defs/nonEmptyString" },
    "source": { "$ref": "common.json#/$defs/source" },
    "last_updated": { "$ref": "common.json#/$defs/isoDate" },
    "deferred": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "concept", "why_deferred", "unblocks_when", "published"],
        "properties": {
          "id": { "$ref": "common.json#/$defs/kebabId" },
          "concept": { "$ref": "common.json#/$defs/nonEmptyString" },
          "why_deferred": { "$ref": "common.json#/$defs/nonEmptyString" },
          "unblocks_when": { "$ref": "common.json#/$defs/nonEmptyString" },
          "published": {
            "type": "boolean",
            "description": "True if the generated site or landing page already asserts this concept to readers. Published-but-unmodelled is tracked debt, not an accepted state."
          },
          "published_where": { "$ref": "common.json#/$defs/nonEmptyString" }
        }
      }
    }
  }
}
