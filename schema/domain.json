{
  "$id": "https://capability-model.local/schema/domain.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Domain",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "owner", "source", "last_updated"],
  "properties": {
    "id": { "$ref": "common.json#/$defs/kebabId" },
    "name": { "$ref": "common.json#/$defs/nonEmptyString" },
    "description": { "$ref": "common.json#/$defs/nonEmptyString" },
    "status": { "$ref": "common.json#/$defs/status" },
    "owner": { "$ref": "common.json#/$defs/nonEmptyString" },
    "source": { "$ref": "common.json#/$defs/source" },
    "last_updated": { "$ref": "common.json#/$defs/isoDate" }
  }
}
