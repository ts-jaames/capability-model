{
  "$id": "https://capability-model.local/schema/intensity.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intensity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "owner",
    "source",
    "last_updated",
    "dials"
  ],
  "properties": {
    "id": { "$ref": "common.json#/$defs/kebabId" },
    "name": { "$ref": "common.json#/$defs/nonEmptyString" },
    "description": { "$ref": "common.json#/$defs/nonEmptyString" },
    "status": { "$ref": "common.json#/$defs/status" },
    "owner": { "$ref": "common.json#/$defs/nonEmptyString" },
    "source": { "$ref": "common.json#/$defs/source" },
    "last_updated": { "$ref": "common.json#/$defs/isoDate" },
    "floor_note": { "$ref": "common.json#/$defs/nonEmptyString" },
    "dial_placement": { "$ref": "common.json#/$defs/nonEmptyString" },
    "risk_questions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answers_to", "behaviour"],
        "properties": {
          "question": { "$ref": "common.json#/$defs/nonEmptyString" },
          "answers_to": { "type": "string", "enum": ["level", "intensity"] },
          "behaviour": { "$ref": "common.json#/$defs/nonEmptyString" }
        }
      }
    },
    "dials": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "$ref": "common.json#/$defs/dialId" },
          "name": { "$ref": "common.json#/$defs/nonEmptyString" },
          "description": { "$ref": "common.json#/$defs/nonEmptyString" }
        }
      }
    }
  }
}
