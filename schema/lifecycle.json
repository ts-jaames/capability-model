{
  "$id": "https://capability-model.local/schema/lifecycle.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "summary",
    "stages",
    "owner",
    "source",
    "last_updated"
  ],
  "properties": {
    "id": { "$ref": "common.json#/$defs/kebabId" },
    "name": { "$ref": "common.json#/$defs/nonEmptyString" },
    "summary": { "$ref": "common.json#/$defs/nonEmptyString" },
    "description": { "$ref": "common.json#/$defs/nonEmptyString" },
    "pipeline_note": { "$ref": "common.json#/$defs/nonEmptyString" },
    "companion": { "type": "string" },
    "status": { "$ref": "common.json#/$defs/status" },
    "visibility": { "$ref": "common.json#/$defs/visibility" },
    "owner": { "$ref": "common.json#/$defs/nonEmptyString" },
    "source": { "$ref": "common.json#/$defs/source" },
    "last_updated": { "$ref": "common.json#/$defs/isoDate" },
    "commercial_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "stages", "description"],
      "properties": {
        "name": { "$ref": "common.json#/$defs/nonEmptyString" },
        "stages": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "description": { "$ref": "common.json#/$defs/nonEmptyString" },
        "agentic_note": { "$ref": "common.json#/$defs/nonEmptyString" }
      }
    },
    "principles": {
      "description": "Principles that hold across the whole pipeline in either mode. Not agentic-specific, so they live here and not in agentic_mode.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "$ref": "common.json#/$defs/nonEmptyString" },
          "description": { "$ref": "common.json#/$defs/nonEmptyString" }
        }
      }
    },
    "agentic_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "description", "question", "asked_at", "decided_at"],
      "properties": {
        "name": { "$ref": "common.json#/$defs/nonEmptyString" },
        "summary": { "$ref": "common.json#/$defs/nonEmptyString" },
        "description": { "$ref": "common.json#/$defs/nonEmptyString" },
        "question": { "$ref": "common.json#/$defs/nonEmptyString" },
        "asked_at": { "type": "integer", "minimum": 0 },
        "decided_at": { "type": "integer", "minimum": 0 },
        "pipeline_note": { "$ref": "common.json#/$defs/nonEmptyString" },
        "added_principles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description"],
            "properties": {
              "name": { "$ref": "common.json#/$defs/nonEmptyString" },
              "description": { "$ref": "common.json#/$defs/nonEmptyString" }
            }
          }
        },
        "core_shifts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension"],
            "properties": {
              "dimension": { "$ref": "common.json#/$defs/nonEmptyString" },
              "conventional": { "$ref": "common.json#/$defs/nonEmptyString" },
              "agentic": { "$ref": "common.json#/$defs/nonEmptyString" }
            }
          }
        },
        "commercial_constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["constraint", "response"],
            "properties": {
              "constraint": { "$ref": "common.json#/$defs/nonEmptyString" },
              "response": { "$ref": "common.json#/$defs/nonEmptyString" }
            }
          }
        },
        "domain_notes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain", "note"],
            "properties": {
              "domain": { "$ref": "common.json#/$defs/kebabId" },
              "note": { "$ref": "common.json#/$defs/nonEmptyString" }
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description"],
            "properties": {
              "name": { "$ref": "common.json#/$defs/nonEmptyString" },
              "description": { "$ref": "common.json#/$defs/nonEmptyString" }
            }
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "name", "objective", "artifact", "gate"],
        "properties": {
          "number": { "type": "integer", "minimum": 0 },
          "name": { "$ref": "common.json#/$defs/nonEmptyString" },
          "objective": { "$ref": "common.json#/$defs/nonEmptyString" },
          "artifact": { "$ref": "common.json#/$defs/nonEmptyString" },
          "gate": { "$ref": "common.json#/$defs/nonEmptyString" },
          "primary_domain": { "$ref": "common.json#/$defs/kebabId" },
          "secondary_domain": { "$ref": "common.json#/$defs/kebabId" },
          "risk_shapes_hot": {
            "type": "array",
            "items": { "$ref": "common.json#/$defs/kebabId" }
          },
          "risk_routing": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["category", "tested_at", "rationale"],
              "properties": {
                "category": { "$ref": "common.json#/$defs/nonEmptyString" },
                "tested_at": { "$ref": "common.json#/$defs/nonEmptyString" },
                "rationale": { "$ref": "common.json#/$defs/nonEmptyString" }
              }
            }
          },
          "procedures": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "description"],
              "properties": {
                "name": { "$ref": "common.json#/$defs/nonEmptyString" },
                "description": { "$ref": "common.json#/$defs/nonEmptyString" }
              }
            }
          },
          "practices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "description"],
              "properties": {
                "name": { "$ref": "common.json#/$defs/nonEmptyString" },
                "description": { "$ref": "common.json#/$defs/nonEmptyString" }
              }
            }
          },
          "tooling": {
            "type": "array",
            "items": { "$ref": "common.json#/$defs/nonEmptyString" }
          },
          "agents_and_hooks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "description"],
              "properties": {
                "name": { "$ref": "common.json#/$defs/nonEmptyString" },
                "description": { "$ref": "common.json#/$defs/nonEmptyString" }
              }
            }
          },
          "framing": { "$ref": "common.json#/$defs/nonEmptyString" },
          "framing_benefits": {
            "type": "array",
            "items": { "$ref": "common.json#/$defs/nonEmptyString" }
          },
          "framing_coda": { "$ref": "common.json#/$defs/nonEmptyString" },
          "entry_routes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "description"],
              "properties": {
                "name": { "$ref": "common.json#/$defs/nonEmptyString" },
                "description": { "$ref": "common.json#/$defs/nonEmptyString" }
              }
            }
          },
          "infrastructure": { "$ref": "common.json#/$defs/nonEmptyString" },
          "output": { "$ref": "common.json#/$defs/nonEmptyString" },
          "note": { "$ref": "common.json#/$defs/nonEmptyString" },
          "agentic": {
            "type": "object",
            "additionalProperties": false,
            "required": ["divergence", "summary"],
            "properties": {
              "divergence": {
                "type": "string",
                "enum": ["additive", "fork"],
                "description": "additive: the stage keeps its shape and takes on extra checks; its artifact and gate may be added to but never replaced. fork: the stage itself changes shape."
              },
              "summary": {
                "$ref": "common.json#/$defs/nonEmptyString",
                "description": "One line on what changes at this stage in agentic mode."
              },
              "name": { "$ref": "common.json#/$defs/nonEmptyString" },
              "objective": { "$ref": "common.json#/$defs/nonEmptyString" },
              "framing": { "$ref": "common.json#/$defs/nonEmptyString" },
              "artifact": { "$ref": "common.json#/$defs/nonEmptyString" },
              "gate": { "$ref": "common.json#/$defs/nonEmptyString" },
              "output": { "$ref": "common.json#/$defs/nonEmptyString" },
              "risk_shapes_hot": {
                "type": "array",
                "items": { "$ref": "common.json#/$defs/kebabId" }
              },
              "procedures": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "description"],
                  "properties": {
                    "name": { "$ref": "common.json#/$defs/nonEmptyString" },
                    "description": { "$ref": "common.json#/$defs/nonEmptyString" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "domain_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "note"],
        "properties": {
          "domain": { "$ref": "common.json#/$defs/kebabId" },
          "note": { "$ref": "common.json#/$defs/nonEmptyString" }
        }
      }
    },
    "raci": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "assignments"],
        "properties": {
          "stage": { "type": "integer", "minimum": 0 },
          "assignments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "designation"],
              "properties": {
                "title": { "$ref": "common.json#/$defs/kebabId" },
                "designation": {
                  "type": "string",
                  "enum": ["R", "A", "C", "I"]
                }
              }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "$ref": "common.json#/$defs/nonEmptyString" },
          "description": { "$ref": "common.json#/$defs/nonEmptyString" }
        }
      }
    }
  }
}
