{
  "$id": "https://capability-model.local/schema/definition.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "term",
    "definition",
    "not",
    "owner",
    "source",
    "last_updated"
  ],
  "properties": {
    "id": { "$ref": "common.json#/$defs/kebabId" },
    "term": { "$ref": "common.json#/$defs/nonEmptyString" },
    "definition": { "$ref": "common.json#/$defs/nonEmptyString" },
    "not": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.json#/$defs/nonEmptyString" }
    },
    "see_also": {
      "type": "array",
      "items": { "$ref": "common.json#/$defs/kebabId" }
    },
    "status": { "$ref": "common.json#/$defs/status" },
    "visibility": { "$ref": "common.json#/$defs/visibility" },
    "owner": { "$ref": "common.json#/$defs/nonEmptyString" },
    "source": { "$ref": "common.json#/$defs/source" },
    "last_updated": { "$ref": "common.json#/$defs/isoDate" }
  }
}
